<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <Button
        android:id="@+id/curve_menu_rgb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:text="@string/curves_channel_rgb"
        android:textColor="@color/white"
        android:textSize="@dimen/effect_list_text_size" />

    <Button
        android:id="@+id/curve_menu_red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:text="@string/curves_channel_red"
        android:textColor="@color/white"
        android:textSize="@dimen/effect_list_text_size" />

    <Button
        android:id="@+id/curve_menu_green"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:text="@string/curves_channel_green"
        android:textColor="@color/white"
        android:textSize="@dimen/effect_list_text_size" />

    <Button
        android:id="@+id/curve_menu_blue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:text="@string/curves_channel_blue"
        android:textColor="@color/white"
        android:textSize="@dimen/effect_list_text_size" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:layout_marginStart="80dp"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <Button
                android:id="@+id/curve_output"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/edit_btn_output_rest"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/filtershow_curves_output"
                android:textColor="@color/white"
                android:textSize="@dimen/curve_io_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:layout_marginStart="240dp"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <Button
                android:id="@+id/curve_input"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/edit_btn_output_rest"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/filtershow_curves_input"
                android:textColor="@color/white"
                android:textSize="@dimen/curve_io_text_size" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>